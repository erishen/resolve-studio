# Copy to `.env` and fill in to use the `llm-openai` adapter.
# Any OpenAI-compatible endpoint works (OpenAI, DeepSeek, local llama.cpp, ...).

OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=deepseek-chat

# ---- Runtime (optional) ----
# NODE_ENV=development
# DEBUG=*            # standard debug flag, forwarded to Cordis logger

# ---- Workspace analysis (optional) ----
# Directory where workspace-scan.mjs writes its report (projects.json, index.html).
# Defaults to <cwd>/workspace-analysis when unset.
# WORKSPACE_OUT=/path/to/workspace-analysis

# Path to the `uv` binary used by workspace-scan.mjs to run serena.
# Defaults to `uv` (looked up on PATH) when unset.
# SERENA_UV=/path/to/uv

# FORCE=1           # workspace-scan.mjs: ignore cache, rescan everything
# SCAN_ONLY=1       # workspace-scan.mjs: only (re)generate the report, skip deeper analysis

# ---- Filesystem sandbox (optional) ----
# Colon-separated extra read-only roots beyond the working directory.
# Useful for letting read-file / analyze-dir reach sibling projects.
# HARNESS_EXTRA_ROOTS=/path/to/project-a:/path/to/project-b

# Set to 1 to allow `..` in shell commands (still blocks absolute-path escapes).
# HARNESS_SHELL_ALLOW_TRAVERSAL=1

# OS-level sandbox for shell commands (macOS Seatbelt / Linux bwrap).
# When enabled, shell commands can only write to the working directory + temp dir.
# SANDBOX_ENABLED=true
# SANDBOX_ALLOW_NETWORK=true

# ---- Skills (optional) ----
# Directory of the shared skills repository, merged with the local skills/ dir
# (local takes priority). Resolved by skills.ts and pse.ts.
# HARNESS_SKILLS_DIR=/path/to/skills

# ---- PSE three-role mode (optional) ----
# Planner-Specialist-Evaluator workflow. Can also be toggled from the UI.
# PSE_ENABLED=false
# PSE_SOULS_DIR=/path/to/souls  # optional, defaults to HARNESS_SKILLS_DIR/../souls
# PSE_REVIEW_PROVIDER=free      # default reviewer provider for tool-pse-review

# ---- Usage / cost tracking (optional) ----
# JSON map of per-model prices in CNY per 1K tokens (input / output).
# Merged on top of the built-in defaults.
# HARNESS_PRICES={"my-model":{"in":0.001,"out":0.004}}

# ---- WordPress (post-comment skill, optional) ----
# PROD_WORDPRESS_USERNAME=your-username
# PROD_WORDPRESS_APP_PASSWORD=your-app-password
# ERISHEN_BASE=https://erishen.cn   # base URL for tool-pick-post (your blog)

# ---- External project paths (optional) ----
# Used by tool-article-write, tool-pse-review, tool-portfolio-summary to locate
# sibling frameworks. When unset, each tool falls back to a relative path from
# its source file (…/***REMOVED***/frameworks/<name>).
# CREWAI_PSE_DIR=/absolute/path/to/crewai-pse
# AUTOGEN_PSE_DIR=/absolute/path/to/autogen-pse
# LLAMAINDEX_PSE_DIR=/absolute/path/to/llamaindex-pse
# LANGGRAPH_PSE_DIR=/absolute/path/to/langgraph-pse
# WORDPRESS_TOOLS_DIR=/absolute/path/to/wordpress-tools
